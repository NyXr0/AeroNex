# Optional. Base URL the frontend calls for the AeroNex API.
# Defaults to http://localhost:8000 if unset (see lib/api.ts).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional. Only needed for live real-time updates (Supabase Realtime).
# Without these, the dashboard still works via normal API polling/fetch.
# Find them in the Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
