# Optional. When unset, the backend uses local SQLite (Backend/data/aeronex_spike.db) -
# nothing else to configure for local dev.
#
# Set this to point the backend at the real Postgres database (Supabase) instead.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Find it in the Supabase dashboard: Project Settings -> Database -> Connection string.
DATABASE_URL=

# Optional. Port the API server binds to. Most cloud hosts (Render, Railway, Fly.io)
# inject this automatically. Defaults to 8000 for local dev.
PORT=8000
